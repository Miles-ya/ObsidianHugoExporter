{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"isolatedModules": true,
		"lib": ["DOM", "ES2018"],
		"module": "ESNext",
		"moduleResolution": "node",
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2018"
	},
	"include": ["**/*.ts"]
}
